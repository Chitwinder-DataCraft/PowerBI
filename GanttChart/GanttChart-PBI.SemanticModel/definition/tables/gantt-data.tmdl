	column 'Task Label' =
			
			VAR Days = DATEDIFF ( 'gantt-data'[ActualStart], 'gantt-data'[ActualEnd], DAY ) + 1
			VAR DateText =
			    IF (
			        MONTH ( 'gantt-data'[ActualStart] ) = MONTH ( 'gantt-data'[ActualEnd] ),
			        FORMAT ( 'gantt-data'[ActualStart], "MMM d" ) & "–" & FORMAT ( 'gantt-data'[ActualEnd], "d" ),
			        FORMAT ( 'gantt-data'[ActualStart], "MMM d" ) & "–" & FORMAT ( 'gantt-data'[ActualEnd], "MMM d" )
			    )
			RETURN
			    'gantt-data'[Task] & "   |   " & DateText & "   |   " & Days & "d"
		lineageTag: a44f782c-89bc-4d2c-ab44-fca04bff3297
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Phase Color' =
			
			SWITCH (
			    'gantt-data'[Task],
			    "Project Delivery", "#3F3FB5",
			    "Solution Delivery", "#0F766E",
			    "Quality Assurance", "#B45309",
			    "Release Management", "#BE123C",
			    "#6B7280"
			)
		lineageTag: 8a54a676-592c-4f63-afbc-21acfeb7e47a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

