	partition gantt-data = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents("C:\Users\dell\Downloads\GanttChart-PowerBI\gantt-data.csv"), [Delimiter = ",", Columns = 9, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
