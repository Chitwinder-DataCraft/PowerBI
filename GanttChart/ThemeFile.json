{
  "name": "Project Timeline",
  "dataColors": ["#3F3FB5", "#0F766E", "#B45309", "#BE123C", "#6B7280", "#9CA3AF"],
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#3F3FB5",
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 12 }],
        "title": [{ "fontFamily": "Segoe UI", "fontSize": 11 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F4F5F9" } }, "transparency": 0 }] }
